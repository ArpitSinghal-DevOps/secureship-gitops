#!/usr/bin/env bash
# Prometheus + Grafana in Docker, next to the minikube container (nothing installed on the host).
#   tools/monitoring up       start (or restart) both containers
#   tools/monitoring down     stop and remove them (data is kept)
#   tools/monitoring status   show containers and scrape targets
#   tools/monitoring purge    down + delete stored metrics, Grafana data and the copied token
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
MON="$HERE/monitoring"
NODE="${NODE:-secureship}"
NET="${NET:-secureship}"            # the minikube profile's Docker network
PROM_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.2.6
PROM=secureship-prometheus
GRAFANA=secureship-grafana
SECRETS="$MON/.secrets"
DATA="$MON/.data"

die() { echo "error: $*" >&2; exit 1; }

down() { docker rm -f "$PROM" "$GRAFANA" >/dev/null 2>&1 || true; }

up() {
  [ "$(docker inspect -f '{{.State.Running}}' "$NODE" 2>/dev/null)" = true ] \
    || die "minikube container '$NODE' is not running; run ./scripts/bootstrap.sh first"

  umask 077
  mkdir -p "$SECRETS" "$DATA/prometheus" "$DATA/grafana"

  echo "Fetching the read-only metrics token (created by the Helm chart via Argo CD)..."
  for _ in $(seq 1 30); do
    tok=$("$HERE/tools/k" -n secureship get secret secureship-metrics-reader \
            -o jsonpath='{.data.token}' 2>/dev/null || true)
    [ -n "$tok" ] && break
    sleep 5
  done
  [ -n "${tok:-}" ] || die "secret secureship/secureship-metrics-reader not found; is the secureship app synced?"
  printf '%s' "$tok" | base64 -d > "$SECRETS/token"
  docker exec "$NODE" cat /var/lib/minikube/certs/ca.crt > "$SECRETS/ca.crt"
  [ -s "$SECRETS/grafana-admin" ] || head -c 18 /dev/urandom | base64 | tr -d '/+=' > "$SECRETS/grafana-admin"

  NODE_IP=$(docker inspect -f "{{(index .NetworkSettings.Networks \"$NET\").IPAddress}}" "$NODE")
  down

  docker run -d --name "$PROM" --network "$NET" \
    --add-host "control-plane.minikube.internal:$NODE_IP" \
    --user "$(id -u):$(id -g)" --memory 300m --cpus 0.5 \
    --read-only --security-opt no-new-privileges --cap-drop ALL \
    -p 127.0.0.1:9090:9090 \
    -v "$MON/prometheus.yml:/etc/prometheus/prometheus.yml:ro" \
    -v "$SECRETS:/etc/prometheus/secrets:ro" \
    -v "$DATA/prometheus:/prometheus" \
    "$PROM_IMAGE" \
      --config.file=/etc/prometheus/prometheus.yml \
      --storage.tsdb.path=/prometheus \
      --storage.tsdb.retention.time=2d >/dev/null

  docker run -d --name "$GRAFANA" --network "$NET" \
    --user "$(id -u):$(id -g)" --memory 256m --cpus 0.5 \
    --security-opt no-new-privileges --cap-drop ALL \
    -p 127.0.0.1:3000:3000 \
    -e GF_SECURITY_ADMIN_PASSWORD="$(cat "$SECRETS/grafana-admin")" \
    -e GF_ANALYTICS_REPORTING_ENABLED=false \
    -e GF_ANALYTICS_CHECK_FOR_UPDATES=false \
    -e GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/dashboards/secureship.json \
    -v "$DATA/grafana:/var/lib/grafana" \
    -v "$MON/grafana/datasources:/etc/grafana/provisioning/datasources:ro" \
    -v "$MON/grafana/dashboards:/etc/grafana/provisioning/dashboards:ro" \
    -v "$HERE/chart/secureship/dashboards:/etc/grafana/dashboards:ro" \
    "$GRAFANA_IMAGE" >/dev/null

  echo
  echo "Prometheus: http://localhost:9090/targets"
  echo "Grafana:    http://localhost:3000  (user admin, password in monitoring/.secrets/grafana-admin)"
  echo "Note: the Grafana password applies on first start; after 'purge' a new one is generated."
}

status() {
  docker ps -a --filter "name=secureship-" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  echo
  curl -s http://localhost:9090/api/v1/targets 2>/dev/null \
    | python3 -c 'import sys,json
for t in json.load(sys.stdin)["data"]["activeTargets"]:
    print(t["labels"].get("pod","?"), t["health"], t["lastError"])' \
    || echo "Prometheus is not reachable on localhost:9090"
}

case "${1:-}" in
  up) up ;;
  down) down; echo "stopped (data kept in monitoring/.data)" ;;
  status) status ;;
  purge) down; rm -rf "$DATA" "$SECRETS"; echo "removed containers, data and token" ;;
  *) sed -n '2,7p' "$0"; exit 1 ;;
esac
